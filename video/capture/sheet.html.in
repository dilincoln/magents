<!doctype html>
<!-- Several frames of one take at half size, two to a row, for review:
     sheet.html?take=overview&ts=0.5,2,3.5,5
     A template, not a composition: capture/sheet fills in @CAPTURE@ and
     writes the page to /tmp/mgv-review, so the project holds no stray .html -->
<html>
<head>
<meta charset="utf-8" />
<base href="@CAPTURE@/" />
<link rel="stylesheet" href="../lib/term.css" />
<style>
	body { margin: 0; background: #000; display: grid; grid-template-columns: 840px 840px; }
	.cell { width: 840px; height: 495px; overflow: hidden; position: relative; }
	.cell .term { transform: scale(0.5); transform-origin: 0 0; }
	.cell b { position: absolute; right: 6px; bottom: 4px; color: #ff0; font: 700 18px monospace; background: #000a; padding: 0 4px; }
</style>
<script src="../lib/term.js"></script>
<script>
	const q = new URLSearchParams(location.search);
	document.write(`<script src="../takes/${q.get("take")}.js"><\/script>`);
</script>
</head>
<body>
<script>
	for (const t of q.get("ts").split(",").map(Number)) {
		const cell = document.createElement("div");
		cell.className = "cell";
		const el = document.createElement("div");
		cell.appendChild(el);
		const label = document.createElement("b");
		label.textContent = `${t}s`;
		cell.appendChild(label);
		document.body.appendChild(cell);
		TermPlayer(el, TAKES[q.get("take")]).show(t);
	}
</script>
</body>
</html>
