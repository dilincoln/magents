{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		// Generated files, and the one place in the repo where nothing is written by
		// hand. `!daemon/migrations` and not `!daemon/migrations/**`: the trailing
		// glob was needed before Biome 2.2 and is now flagged by its own linter.
		"includes": ["**", "!daemon/migrations", "!video"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// Off wholesale, not rule by rule. Every one of these reasons about a
			// DOM — roles, tab order, focus rings, screen readers — and there is
			// no DOM here: `<box>` and `<text>` are terminal renderables that
			// happen to be spelled as JSX, and a click handler on one is the only
			// way a pointer can reach anything. So the group is not merely noisy,
			// it is answering a question about a document that does not exist,
			// and every finding it has ever produced in this repo has been a
			// false one. Accessibility in a TUI is the keyboard, which is why
			// every clickable thing here also has a key in `bindings.ts`.
			"a11y": "off",
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
