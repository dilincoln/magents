<!doctype html>
<!-- One recorded frame, full size, for checking the terminal renderer:
     preview.html?take=probe&t=1.5  (open with --allow-file-access-from-files)
     A template, not a composition: capture/shot fills in @CAPTURE@ and
     writes the page to /tmp/mgv-review, so the project holds no stray .html -->
<html>
<head>
<meta charset="utf-8" />
<base href="@CAPTURE@/" />
<link rel="stylesheet" href="../lib/term.css" />
<style>body{margin:0;background:#000}#t{display:inline-block}</style>
<script src="../lib/term.js"></script>
<script>
	const q = new URLSearchParams(location.search);
	document.write(`<script src="../takes/${q.get("take")}.js"><\/script>`);
</script>
</head>
<body>
<div id="t"></div>
<script>
	const take = TAKES[q.get("take")];
	const p = TermPlayer(document.getElementById("t"), take);
	p.show(Number(q.get("t") || 0));
</script>
</body>
</html>
